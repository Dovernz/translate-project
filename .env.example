# ==============================================================================
# GEMINITRANS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các khóa API thực tế trước khi khởi chạy.
# ==============================================================================

# 1. GOOGLE AI STUDIO / GEMINI API KEYS (BẮT BUỘC)
# Hỗ trợ cấu hình nhiều API Key phân tách bằng dấu phẩy để kích hoạt cơ chế
# Smart Key Pool (xoay vòng Round-Robin 7 Cloud Projects, tự động bypass rate-limit)
GEMINI_API_KEYS=AIzaSy_YOUR_KEY_1,AIzaSy_YOUR_KEY_2,AIzaSy_YOUR_KEY_3,AIzaSy_YOUR_KEY_4,AIzaSy_YOUR_KEY_5,AIzaSy_YOUR_KEY_6,AIzaSy_YOUR_KEY_7

# Fallback: API Key đơn lẻ (nếu chỉ có 1 dự án)
GEMINI_API_KEY=

# 2. ENDPOINTS & API GATEWAY
# Base URL kết nối Google Generative Language API
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models

# 3. CẤU HÌNH MẠNG & DOCKER PORT
# Port chạy dịch vụ bên ngoài host (mặc định 8090 để không xung đột 8000/8080)
TRANSLATE_PORT=8090

# Port và Host nội bộ container
APP_PORT=8000
APP_HOST=0.0.0.0

# 4. CHÍNH SÁCH COOLDOWN & TIMEOUT
# Thời gian cách ly Key (giây) khi gặp lỗi HTTP 429 (vượt quá hạn ngạch)
COOLDOWN_SECONDS=60

# Timeout cho kết nối HTTP Streaming (giây)
REQUEST_TIMEOUT=60.0
